<?xml version="1.0" encoding="UTF-8"?>
<node name="controller">
  <!-- QLET control/status channel only. The payload's feedback destination
       must be configured as this host's IP (PDF default 192.168.1.121:10000).
       Binding 0.0.0.0 does not change the device's destination configuration. -->
  <param name="local_ip" type="string" value="0.0.0.0"/>
  <param name="local_port" type="int" value="10000"/>
  <param name="gimbal_ip" type="string" value="192.168.1.160"/>
  <param name="gimbal_port" type="int" value="10000"/>
  <param name="send_period_ms" type="int" value="20"/>
  <param name="feedback_timeout_ms" type="int" value="500"/>
  <param name="command_ttl_ms" type="int" value="500"/>
  <param name="max_command_ttl_ms" type="int" value="2000"/>
  <param name="queue_limit" type="int" value="64"/>
  <param name="require_online" type="bool" value="true"/>
  <param name="telemetry_enabled" type="bool" value="false"/>
  <param name="frame_id" type="string" value="gimbal"/>
  <param name="command_topic" type="string" value="controller/gimbal/command"/>
  <param name="state_topic" type="string" value="controller/gimbal/state"/>
  <param name="result_topic" type="string" value="controller/gimbal/command_result"/>
  <param name="link_topic" type="string" value="controller/gimbal/link_state"/>
  <param name="telemetry_topic" type="string" value="controller/aircraft/telemetry"/>
  <!-- Flight navigation is still a stub, independent from real gimbal control. -->
  <param name="goto_delay_ms" type="int" value="4000"/>
  <param name="force_failure" type="bool" value="false"/>
</node>
